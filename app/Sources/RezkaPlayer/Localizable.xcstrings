    "Films" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Фильмы" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Фільми" } }
      }
    },
    "Find films, series, cartoons and anime by title." : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ищите фильмы, сериалы, мультфильмы и аниме по названию." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Шукайте фільми, серіали, мультфільми та аніме за назвою." } }
      }
    },
    "Finished movies/episodes are marked watched on Trakt, and Watch Later additions are mirrored to your Trakt watchlist." : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Просмотренные фильмы и эпизоды отмечаются как просмотренные в Trakt, а добавления в «Смотреть позже» дублируются в ваш список Trakt." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Переглянуті фільми та епізоди позначаються як переглянуті в Trakt, а додавання до «Дивитися пізніше» дублюються у ваш список Trakt." } }
      }
    },
    "from your Trakt API app" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "из вашего API-приложения Trakt" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "з вашого API-застосунку Trakt" } }
      }
    },
    "Go to" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перейти к" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Перейти до" } }
      }
    },
    "Go to a section or search titles…" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перейти в раздел или искать названия…" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Перейти до розділу або шукати назви…" } }
      }
    },
    "HDRezka account" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Аккаунт HDRezka" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Акаунт HDRezka" } }
      }
    },
    "HDRezka mirror" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Зеркало HDRezka" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Дзеркало HDRezka" } }
      }
    },
    "HDRezka rotates domains and may be geo-blocked. Paste a mirror that works for you (include https://)." : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "HDRezka меняет домены и может быть заблокирована по региону. Вставьте рабочее для вас зеркало (включая https://)." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "HDRezka змінює домени та може бути заблокована за регіоном. Вставте робоче для вас дзеркало (включно з https://)." } }
      }
    },
    "HDRezka's video CDN is geo-blocked in some regions. A SOCKS5/HTTP proxy in a permitted region routes scraping, playback and downloads through it. Many VPNs expose a SOCKS5 endpoint (PIA, NordVPN, Windscribe, Mullvad). Leave empty to go direct." : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Видео-CDN HDRezka заблокирован по региону в некоторых странах. Прокси SOCKS5/HTTP в разрешённом регионе направляет через себя сбор данных, воспроизведение и загрузки. Многие VPN предоставляют точку SOCKS5 (PIA, NordVPN, Windscribe, Mullvad). Оставьте пустым для прямого подключения." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Відео-CDN HDRezka заблоковано за регіоном у деяких країнах. Проксі SOCKS5/HTTP у дозволеному регіоні спрямовує через себе збір даних, відтворення та завантаження. Багато VPN надають точку SOCKS5 (PIA, NordVPN, Windscribe, Mullvad). Залиште порожнім для прямого підключення." } }
      }
    },
    "Helper error: %@" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ошибка помощника: %@" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Помилка помічника: %@" } }
      }
    },
    "Helper ready · :%lld" : {
